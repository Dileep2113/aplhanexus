# ==============================================================================
# AlphaNexus AI Trading Suite - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides. NEVER commit .env to version control.
# On Render / Cloudflare, set these key-value pairs in the platform Dashboard settings.

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Port for the web dashboard and REST API. Render sets this automatically via $PORT.
PORT=8050
HOST=0.0.0.0
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. Database & Persistence (Zero-Cost Options)
# ------------------------------------------------------------------------------
# Default: Local SQLite (analyst_data.db).
# Production Persistent Option: Free Neon or Supabase Serverless PostgreSQL.
# If DATABASE_URL is set, the application will use the external PostgreSQL instance.
# Example: postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Market Data Providers (Keyless / Free Tier Defaults)
# ------------------------------------------------------------------------------
# Primary quote provider: yahoo (delayed 15m, free, no API key required)
DATA_PRIMARY=yahoo
# Context provider: nse (direct nseindia.com browser impersonation, free)
DATA_CONTEXT=nse
# Maximum age of price bars in seconds before flagged as STALE (1200s = 20 min)
MAX_BAR_AGE_SECONDS=1200
REQUEST_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------------------
# 4. Risk Governance Ceiling (Observer / Non-Destructive Mode)
# ------------------------------------------------------------------------------
# Virtual test capital (INR) for sizing and friction auditing
ACCOUNT_CAPITAL=500000
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=1.5
MAX_OPEN_POSITIONS=3

# ------------------------------------------------------------------------------
# 5. Live Broker Execution Safety Lock
# ------------------------------------------------------------------------------
# MANDATORY: Keep set to false. Order routing is locked in observational mode.
ENABLE_LIVE_BROKER_EXECUTION=false
